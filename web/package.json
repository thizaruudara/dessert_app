{
  "name": "edupeak-ios-pwa",
  "version": "1.0.0",
  "description": "EduPeak Physics Institute iOS PWA & Web App with Camera Scanner & Push Notifications",
  "main": "index.html",
  "scripts": {
    "build": "esbuild js/app.js --bundle --platform=browser --format=esm --outfile=js/app.bundle.js",
    "start": "node dev-server.cjs"
  },
  "keywords": [
    "pwa",
    "ios",
    "education",
    "physics",
    "scanner",
    "push-notifications"
  ],
  "author": "EduPeak Team",
  "license": "ISC",
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "jwks-rsa": {
      "jose": "4.15.9"
    },
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0"
  }
}
