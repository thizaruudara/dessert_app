rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    match /users/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      // Provisioning and role changes are performed by trusted Admin SDK code.
      allow create: if false;
      allow update: if isAdmin() || (isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'avatarUrl', 'photoUrl', 'examYear', 'fcmToken', 'fcmTokens', 'lastTokenUpdate']));
      allow delete: if isAdmin();
    }
    match /leaderboard_public/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /desserts/{id} {
      allow get: if signedIn() && (isAdmin() || resource.data.studentId == request.auth.uid);
      allow list: if isAdmin() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.creditsAwarded == 0;
      allow update, delete: if isAdmin();
    }

    match /paper_sessions/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /paper_registrations/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow update: if isAdmin() || (signedIn() && resource.data.studentId == request.auth.uid
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'answers', 'submissionPhotos', 'submissionUrl', 'submittedAt', 'status', 'driveLink',
          'isCameraActive', 'lastCameraPing', 'agoraUid', 'cameraSnapshotUrl', 'joinedAt'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || request.resource.data.status in ['in_exam', 'submitted']));
      allow create: if false;
      allow delete: if isAdmin();
    }
    match /proctor_alerts/{id} {
      allow read: if isAdmin() || (signedIn() && (resource.data.studentId == request.auth.uid || resource.data.studentId == 'ALL'));
      allow create: if signedIn() && (isAdmin() || request.resource.data.studentId == request.auth.uid);
      allow update: if isAdmin() || (signedIn() && resource.data.studentId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']));
      allow delete: if isAdmin();
    }
    match /daily_sprints/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /sprint_attempts/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow create: if false;
      allow update, delete: if isAdmin();
    }
    match /announcements/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /upcoming_papers/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /paper_leaderboards/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /exam_countdowns/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /system_config/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /credits_history/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin();
    }
    match /submissions/{id} { allow read, write: if isAdmin(); }
    match /dessert_reviews/{id} { allow read, write: if isAdmin(); }
    // OTP documents must only be accessed by trusted server-side code.
    match /otp_requests/{id} { allow read, write: if false; }
    match /otp_verifications/{id} { allow read, write: if false; }
    match /account_phone_index/{id} { allow read, write: if false; }
    match /users/{uid}/{subcollection}/{docId} {
      allow read, write: if isAdmin();
    }

    // All collections are private unless explicitly granted above.
    match /{document=**} { allow read, write: if false; }
  }
}
