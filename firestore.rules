rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if true;
    }

    match /desserts/{dessertId} {
      allow read, write: if true;
    }

    match /otp_requests/{docId} {
      allow read, write: if true;
    }

    match /otp_verifications/{phone} {
      allow read, write: if true;
    }

    match /paper_sessions/{sessionId} {
      allow read, write: if true;
    }

    match /paper_registrations/{regId} {
      allow read, write: if true;
    }

    match /proctor_alerts/{alertId} {
      allow read, write: if true;
    }

    match /daily_sprints/{sprintId} {
      allow read, write: if true;
    }

    match /announcements/{docId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
