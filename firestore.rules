rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if true;
    }

    match /desserts/{dessertId} {
      allow read, write: if true;
    }

    match /otp_requests/{docId} {
      allow read, write: if true;
    }

    match /otp_verifications/{phone} {
      allow read, write: if true;
    }
  }
}
