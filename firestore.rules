rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if true;
    }

    // ── Desserts ───────────────────────────────────────────────────
    match /desserts/{dessertId} {
      allow read, write: if true;
    }

    // ── WhatsApp OTP Requests & Verifications ──────────────────────
    match /otp_requests/{docId} {
      allow read, write: if true;
    }
    match /otp_verifications/{phone} {
      allow read, write: if true;
    }
  }
}
